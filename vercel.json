
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/cpanel/?$",
      "status": 302,
      "headers": {
        "Location": "https://leadhive-ai.com:2083/"
      }
    },
    {
      "src": "^/auth(?<path>/.*)?$",
      "dest": "https://winter-hangover-fog.ngrok-free.dev/auth$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tunnel-Skip-AntiPhishing-Page"
          },
          "args": "true"
        }
      ]
    },
    {
      "src": "^/api(?<path>/.*)?$",
      "dest": "https://winter-hangover-fog.ngrok-free.dev/api$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tunnel-Skip-AntiPhishing-Page"
          },
          "args": "true"
        }
      ]
    },
    {
      "src": "^/business-profile(?<path>/.*)?$",
      "dest": "https://winter-hangover-fog.ngrok-free.dev/business-profile$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tunnel-Skip-AntiPhishing-Page"
          },
          "args": "true"
        }
      ]
    },
    {
      "src": "^/selection-videos(?<path>/.*)?$",
      "dest": "https://winter-hangover-fog.ngrok-free.dev/selection-videos$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tunnel-Skip-AntiPhishing-Page"
          },
          "args": "true"
        }
      ]
    },
    {
      "src": "^/comments(?<path>/.*)?$",
      "dest": "https://winter-hangover-fog.ngrok-free.dev/comments$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tunnel-Skip-AntiPhishing-Page"
          },
          "args": "true"
        }
      ]
    },
    {
      "src": "^/ai(?<path>/.*)?$",
      "dest": "https://winter-hangover-fog.ngrok-free.dev/ai$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tunnel-Skip-AntiPhishing-Page"
          },
          "args": "true"
        }
      ]
    },
    {
      "src": "^/analytics(?<path>/.*)?$",
      "dest": "https://winter-hangover-fog.ngrok-free.dev/analytics$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tunnel-Skip-AntiPhishing-Page"
          },
          "args": "true"
        }
      ]
    },
    {
      "src": "^/demo(?<path>/.*)?$",
      "dest": "https://winter-hangover-fog.ngrok-free.dev/demo$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tunnel-Skip-AntiPhishing-Page"
          },
          "args": "true"
        }
      ]
    },
    {
      "src": "^/privacy$",
      "dest": "/privacy/index.html"
    },
    {
      "src": "^/terms$",
      "dest": "/terms/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ]
}
