{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/cpanel/?$",
      "status": 302,
      "dest": "https://core47.hostingmadeeasy.com:2083/"
    },
    {
      "src": "^/auth(?<path>/.*)?$",
      "dest": "https://8qgnw9pl-8005.inc1.devtunnels.ms/auth$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "X-Tunnel-Skip-AntiPhishing-Page" },
          "args": "true"
        }
      ]
    },
    {
      "src": "^/api(?<path>/(?!facebook(?:/|$)|real-estate(?:/|$)|whatsapp(?:/|$)).*)?$",
      "dest": "https://8qgnw9pl-8005.inc1.devtunnels.ms/api$path",
